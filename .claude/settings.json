{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/valida-frontmatter.mjs\"",
            "timeout": 15,
            "statusMessage": "Validando frontmatter de agents, commands e skills..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-check.sh\"",
            "timeout": 120,
            "statusMessage": "eslint + tsc nos arquivos alterados..."
          }
        ]
      }
    ]
  }
}
